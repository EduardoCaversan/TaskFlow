            <LinearLayout android:id="@+id/empty_state" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:src="@drawable/ic_check_circle_24" android:tint="?attr/colorPrimary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/empty_tasks_title" android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/empty_tasks_message" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/button_add_task" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="@dimen/screen_horizontal_margin" android:layout_marginBottom="20dp" android:contentDescription="@string/add_task" app:icon="@drawable/ic_add_24" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
